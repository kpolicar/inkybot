<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <configSections>
        <sectionGroup name="userSettings" type="System.Configuration.UserSettingsGroup, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089">
            <section name="Inkybot.Properties.Settings" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" allowExeDefinition="MachineToLocalUser" requirePermission="false" />
        </sectionGroup>
        <section name="nlog" type="NLog.Config.ConfigSectionHandler, NLog" />
    </configSections>
    <nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
        <extensions>
            <add assembly="NLog.Targets.OpenTelemetryProtocol" />
        </extensions>
        <targets>
            <target name="logocr" xsi:type="File" fileName="logs/ocr.log" archiveFileName="logs/archive/ocr.{#}.log" archiveNumbering="DateAndSequence" archiveDateFormat="yyyy-MM-dd" archiveOldFileOnStartup="true" maxArchiveFiles="5" layout="${longdate} | ${level} | ${message}" />
            <target name="logmage" xsi:type="File" fileName="logs/maging.log" archiveFileName="logs/archive/maging.{#}.log" archiveNumbering="DateAndSequence" archiveDateFormat="yyyy-MM-dd" archiveOldFileOnStartup="true" maxArchiveFiles="5" layout="${longdate} | ${level} | ${message}" />
            <target name="logcustom" xsi:type="File" fileName="logs/custom.log" archiveFileName="logs/archive/custom.{#}.log" archiveNumbering="DateAndSequence" archiveDateFormat="yyyy-MM-dd" archiveOldFileOnStartup="true" maxArchiveFiles="5" layout="${longdate} | ${level} | ${message}" />
        </targets>

        <rules>
            <logger name="*" minlevel="Info" writeTo="logconsole" />
            <logger name="ocr" minlevel="Debug" writeTo="logocr" />
            <logger name="mage" minlevel="Debug" writeTo="logmage" />
            <logger name="custom" minlevel="Debug" writeTo="logcustom" />
        </rules>
    </nlog>
    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.1" />
    </startup>
    <userSettings>
        <Inkybot.Properties.Settings>
            <setting name="dofusPath" serializeAs="String">
                <value />
            </setting>
            <setting name="email" serializeAs="String">
                <value />
            </setting>
            <setting name="password" serializeAs="String">
                <value />
            </setting>
            <setting name="locale" serializeAs="String">
                <value />
            </setting>
            <setting name="dofusProcessName" serializeAs="String">
                <value>dofus</value>
            </setting>
            <setting name="customResizeRatio" serializeAs="String">
                <value />
            </setting>
            <setting name="FirstTime" serializeAs="String">
                <value>true</value>
            </setting>
            <setting name="NeedsSetup" serializeAs="String">
                <value>true</value>
            </setting>
            <setting name="DisableOpenCL" serializeAs="String">
                <value>false</value>
            </setting>
            <setting name="restoreHighSinkStatImmediately" serializeAs="String">
                <value>true</value>
            </setting>
            <setting name="autoRestartBot" serializeAs="String">
                <value>true</value>
            </setting>
            <setting name="autoStartNewSession" serializeAs="String">
                <value>false</value>
            </setting>
            <setting name="showUserWarnings" serializeAs="String">
                <value>true</value>
            </setting>
            <setting name="enableSafeMageQueueing" serializeAs="String">
